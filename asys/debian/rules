#!/usr/bin/make -f
export CGO_ENABLED=0
export GOFLAGS=-mod=vendor -trimpath -buildvcs=false
export GOPROXY=off
export GOCACHE=$(CURDIR)/debian/.gocache
export GOTOOLCHAIN=local
export PYTHONDONTWRITEBYTECODE=1
GO := $(firstword $(wildcard /usr/lib/go-1.25/bin/go) $(shell command -v go))
DEST := $(CURDIR)/debian/asys
HOSTDEPS := $(CURDIR)/hostdeps

%:
	dh $@ --with python3

override_dh_auto_build:
	$(MAKE) host
	$(MAKE) -C asys-inference build GO=$(GO)
	# Vendored host TUI dependencies are shipped in the source tree (hostdeps/);
	# refresh the stamp so upstream's rule does not call pip.
	test -d $(HOSTDEPS) && touch $(HOSTDEPS)/.installed
	$(MAKE) -C asys-human-interface host HOST_DEPS=$(HOSTDEPS)

override_dh_auto_test:

override_dh_auto_install:
	$(MAKE) install-host DESTDIR=$(DEST) PREFIX=/usr
	$(MAKE) -C asys-inference install DESTDIR=$(DEST) PREFIX=/usr GO=$(GO)
	$(MAKE) -C asys-human-interface install-host DESTDIR=$(DEST) PREFIX=/usr HOST_DEPS=$(HOSTDEPS)
	find $(DEST)/usr/share -name __pycache__ -type d -prune -exec rm -rf {} +
	rm -rf $(DEST)/usr/share/asys-human/vendor/bin
	# Examples are documentation; keep upstream paths so the skill docs stay valid.
	install -d $(DEST)/usr/share/doc/asys/examples
	cp -a asys-bpmn/examples/. $(DEST)/usr/share/doc/asys/examples/
	# asys-server
	install -D -m 0755 debian/server/asys-adduser $(CURDIR)/debian/asys-server/usr/sbin/asys-adduser
	install -D -m 0755 debian/server/asys-deluser $(CURDIR)/debian/asys-server/usr/sbin/asys-deluser
	install -D -m 0755 debian/server/asys-server-update $(CURDIR)/debian/asys-server/usr/sbin/asys-server-update
	install -D -m 0755 debian/server/asys-skills $(CURDIR)/debian/asys-server/usr/bin/asys-skills
	install -D -m 0644 debian/server/server.conf $(CURDIR)/debian/asys-server/etc/asys/server.conf
	install -D -m 0644 debian/server/profile.sh $(CURDIR)/debian/asys-server/etc/profile.d/asys.sh
	install -D -m 0644 debian/server/nginx-asys-dashboard.conf $(CURDIR)/debian/asys-server/usr/share/asys-server/nginx-asys-dashboard.conf
	install -D -m 0644 debian/server/asys-server.tmpfiles $(CURDIR)/debian/asys-server/usr/lib/tmpfiles.d/asys-server.conf

override_dh_python3:
	dh_python3 --no-ext-rename /usr/share/asys/python
	dh_python3 --no-ext-rename /usr/share/asys-inference/python
	dh_python3 --no-ext-rename /usr/share/asys-human/python

override_dh_installsystemd:
	dh_installsystemd -p asys-server --name=asys-dashboard

override_dh_dwz:

override_dh_compress:
	dh_compress -X.md -Xexamples

override_dh_auto_clean:
	rm -rf bin asys-inference/bin asys-human-interface/bin debian/.gocache
